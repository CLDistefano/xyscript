# ============================================================================
# vim.lib  —  a Vim-style modal-editing layer for XyScript (PROTOTYPE)
# ============================================================================
# The XPL-on-top approach to Vim's composable grammar: operators (d/c/y) that
# apply to a following motion or text object, counts, and the common motions —
# all built from existing XyScript verbs, no engine changes. Load it with the
# companion keyboards:
#
#     ADDLIB  examples/vim.lib
#     ADDKBD  vimnorm examples/vim-nav.kbd       # normal mode
#     ADDKBD  viminsert examples/vim-insert.kbd  # insert mode
#     KBDMODE viminsert
#
# COUNT MODEL: a pending count lives in the global `vim_count`. Digit keys in
# normal mode append to it (vim_digit); a motion or operator consumes it and
# clears it. So `3j`, `3dw`, `d` then `iw`, `dd`, `3dd` all work. (A count is a
# SINGLE source here — typed BEFORE the operator, Vim's `3dw`, not `d3w`.)
# ============================================================================

# -- the pending count ------------------------------------------------------
# A digit key (1-9) appends to the pending count. `0` is a motion (line start)
# UNLESS a count is already building, where it is the digit 0 (vim_zero).
SUB vim_digit
  SET vim_count = $vim_count . $1
ENDSUB

SUB vim_zero
  IF LEN($vim_count)
    SET vim_count = $vim_count . "0"
  ELSE
    EL
  EI
ENDSUB

# Fold the pending count into a number (default 1) and clear it. Result in the
# global `vim_n` (XPL routines share state through globals; there is no return
# value to a caller invoked as a command).
SUB vim_takecount
  IF LEN($vim_count)
    SET vim_n = INT($vim_count)
  ELSE
    SET vim_n = 1
  EI
  SET vim_count = ""
ENDSUB

# -- motions (normal mode) --------------------------------------------------
# `vim_move <h|j|k|l|w|b>` — repeat the motion by the pending count. Every
# normal-mode motion key routes through here so counts work uniformly. (This
# indirection — one SUB per keystroke just to honour a count — is exactly the
# boilerplate a NATIVE operator-pending layer would absorb into the input loop.)
SUB vim_move
  LOCAL mkey i
  SET mkey = $1
  vim_takecount
  FOR i = 1 TO $vim_n
    SWITCH $mkey
      CASE "h" ; CL
      CASE "j" ; LD
      CASE "k" ; LU
      CASE "l" ; CR
      CASE "w" ; NW
      CASE "b" ; PW
    ESW
  EF
ENDSUB

# `gg` — a tiny two-key sub-grammar: g then g -> top of file.
SUB vim_g
  LOCAL k
  RK k
  IF $k == "g" ; TF ; EI
  SET vim_count = ""
ENDSUB

# -- the operators: d / c / y, + dot-repeat --------------------------------
# An operator READS the motion/object that follows (and the pending count) and
# stashes the resolved action in globals, then calls vim_apply to perform it.
# `.` (vim_dot) replays that action via vim_apply with NO new keypress — so
# dot-repeat is pure XPL, no engine change. Object/motion keys are stashed as
# SAFE TOKENS (w s p B Q / w b h j k l 0 E) so a replayed `"` or `$` is never
# re-parsed as a string/variable.
SUB vim_op
  LOCAL kind k
  SET kind = $1
  vim_takecount                 # count typed before the operator (3dw)
  SET vim_last_op = $kind
  SET vim_last_n = $vim_n
  RK k                          # the motion / object / doubled-operator key

  # doubled operator -> linewise: dd / cc / yy (count = number of lines)
  IF $k == $kind
    SET vim_last_how = "line"
    SET vim_last_key = "-"
    vim_apply
    RETURN
  EI

  # text object: i {w|s|p} + inner-delimiter i {(|)|b|{|}|[|]}->B, i {"|'|`}->Q
  IF $k == "i"
    RK k
    SET vim_last_how = "obj"
    SWITCH $k
      CASE "w" ; SET vim_last_key = "w"
      CASE "s" ; SET vim_last_key = "s"
      CASE "p" ; SET vim_last_key = "p"
      CASE "(" ; SET vim_last_key = "B"
      CASE ")" ; SET vim_last_key = "B"
      CASE "b" ; SET vim_last_key = "B"
      CASE "{" ; SET vim_last_key = "B"
      CASE "}" ; SET vim_last_key = "B"
      CASE "[" ; SET vim_last_key = "B"
      CASE "]" ; SET vim_last_key = "B"
      CASE "\"" ; SET vim_last_key = "Q"
      CASE "'" ; SET vim_last_key = "Q"
      CASE "`" ; SET vim_last_key = "Q"
      DEFAULT  ; DZ ; RETURN     # unknown object: cancel, change nothing
    ESW
    vim_apply
    RETURN
  EI

  # operator + motion: dw, d$, 3dw, cj, yb, …
  SET vim_last_how = "motion"
  SWITCH $k
    CASE "w" ; SET vim_last_key = "w"
    CASE "b" ; SET vim_last_key = "b"
    CASE "h" ; SET vim_last_key = "h"
    CASE "l" ; SET vim_last_key = "l"
    CASE "j" ; SET vim_last_key = "j"
    CASE "k" ; SET vim_last_key = "k"
    CASE "$" ; SET vim_last_key = "E"
    CASE "0" ; SET vim_last_key = "0"
    DEFAULT  ; DZ ; RETURN       # unknown motion: cancel, change nothing
  ESW
  vim_apply
ENDSUB

# `x` — delete the character under the caret (count-aware), repeatable with `.`.
SUB vim_x
  vim_takecount
  SET vim_last_op = "x"
  SET vim_last_how = "char"
  SET vim_last_key = "-"
  SET vim_last_n = $vim_n
  vim_apply
ENDSUB

# Build the stashed selection (NO keypress) and perform the op. Called live by
# the operators and on replay by vim_dot — the one place the action is realized.
SUB vim_apply
  LOCAL i
  SWITCH $vim_last_how
    CASE "line"
      DL
      FOR i = 2 TO $vim_last_n
        LD
        DM
      EF
    CASE "obj"
      SWITCH $vim_last_key
        CASE "w" ; DW
        CASE "s" ; DS
        CASE "p" ; DP
        CASE "B" ; DIB
        CASE "Q" ; DIQ
        DEFAULT  ; DZ ; RETURN
      ESW
    CASE "char"
      DF
      FOR i = 1 TO $vim_last_n
        CR
      EF
      DM
    DEFAULT
      DF
      FOR i = 1 TO $vim_last_n
        SWITCH $vim_last_key
          CASE "w" ; NW
          CASE "b" ; PW
          CASE "h" ; CL
          CASE "l" ; CR
          CASE "j" ; LD
          CASE "k" ; LU
          CASE "E" ; ER
          CASE "0" ; EL
          DEFAULT  ; DZ ; RETURN
        ESW
      EF
      DM
  ESW
  vim_finish $vim_last_op
ENDSUB

# Apply the operator to the now-built selection. The system clipboard is the
# "unnamed register", so a later `p` pastes what d/x/c/y took.
SUB vim_finish
  LOCAL kind
  SET kind = $1
  SWITCH $kind
    CASE "d" ; CUT
    CASE "x" ; CUT
    CASE "y" ; COPY ; DZ
    CASE "c" ; CUT ; KBDMODE viminsert
  ESW
ENDSUB

# `.` — repeat the last change. Replays the stashed delete/yank at the current
# caret via vim_apply (no new keypress). A change (`c`) is NOT repeated (its
# re-typed text isn't recorded), so `.` right after a `c` is a no-op.
SUB vim_dot
  SET vim_count = ""
  IF LEN($vim_last_op) == 0 ; RETURN ; EI
  IF $vim_last_op == "c" ; RETURN ; EI
  vim_apply
ENDSUB
