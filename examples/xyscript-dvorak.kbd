shift Tab       :15=TAB out
shift '         :16="
shift ,         :17=<
shift .         :18=>
shift P         :19=P
shift Y         :20=Y
shift F         :21=F
shift G         :22=G
shift C         :23=C
shift R         :24=R
shift L         :25=L
shift /         :26=?
