shift Numpad 8  :72=CMH;BC
shift Numpad 9  :73=IF $CM;HI $CM;ELSE;HI;EI
;Comment        ;; Delete from cursor to next punctuation mark
shift Numpad -  :74=QUIET;GT;XD;DF;SE/R/X /\s?[.?!,;:@`\"()\[\]{}\\\n]/;IF NOT $ERROR;CL;DZ;DN;EI;XD
shift Numpad 4  :75=PW
shift Numpad 6  :77=NW
shift Numpad +  :78=+
shift Numpad 1  :79=GT;BS
shift Numpad 2  :80=TH
shift Numpad 3  :81=PD
shift Numpad 0  :82=GT;UNDO
shift Numpad .  :83=RW
shift           :84=NOP
shift           :85=NOP
shift           :86=NOP
shift F11       :87=$SE
shift F12       :88=LOCAL cmnd pos;SET cmnd=$LI;ER;INSERT $NL;SET pos=$CP;XY [$cmnd];JMP $pos
shift           :89=NOP
shift Pause/Bk  :90=NOP
shift Ins       :91=OPEN
shift Home      :92=NOP
shift PgUp      :93=NOP
