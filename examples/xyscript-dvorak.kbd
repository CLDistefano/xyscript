unmod J         :46=j
unmod K         :47=k
unmod X         :48=x
unmod B         :49=b
unmod M         :50=m
unmod W         :51=w
unmod V         :52=v
unmod Z         :53=z
;Comment        ;55=CMH;XC
unmod Numpad *  :55=IF $TX;IF $LI RUNCODE $LI;EX;EI;CMH;XC
unmod Space     :57=AR;" "
unmod F1        :59=MENU
unmod F2        :60=NOP
unmod F3        :61=XD
unmod F4        :62=SA;ADDLIB $FP
unmod F5        :63=BC
unmod F6        :64=NOP
unmod F7        :65=NOP
unmod F8        :66=NOP
unmod F9        :67=CMH;XC
unmod F10       :68=TH 
unmod NumLock   :69=TNL
unmod ScrLock   :70=TSL
unmod Numpad 7  :71=IFNOT $TX;EL;ELSE;IF $CX==0;HM;ELSE;LB;EI;EI
unmod Numpad 8  :72=UP
unmod Numpad 9  :73=PU
unmod Numpad -  :74=IF $D1;SET cmnd="start ";SET arr=GETPATH($DR);IF UPPER($arr[3])=="PDF";SET cmnd=$cmnd."X:\utils\sumatrapdf.exe ";EI;SET cmnd=$cmnd."$DR";RUNCODE X/NV $cmnd;ELSE;SET cmnd=$LI;IF $SE; set cmnd=$SE;EI;X [start $cmnd];EI;CLEAR arr cmnd fn
unmod Numpad 4  :75=CL
unmod Numpad 6  :77=CR
unmod Numpad 1  :79=IFNOT $TX;ER;ELSE;SET pos=$CP;LE;IF $CP==$pos BS;EI;CLEAR pos
;Comment        ;80=IF NOT $TX;GT;ELSE;LD;EI
unmod Numpad 2  :80=LD
unmod Numpad 3  :81=PD
unmod Numpad .  :83=RC
unmod           :84=NOP
unmod           :85=NOP
unmod           :86=NOP
unmod F11       :87=IF $TX;RUNCODE $LI;ELSE;XC;EI
unmod F12       :88=IF $TX;LD;EL;XY [$LI];ELSE;X/BG [$CM];EI
unmod           :89=NOP
unmod Pause/Bk  :90=NOP
;Comment        ; 91=SI
unmod Home      :92=HM
unmod PgUp      :93=PU
unmod Numpad /  :94=CMH;XC
unmod Del       :95=RC
unmod End       :96=BS
unmod PgDn      :97=PD
unmod Up        :100=UP
unmod Left      :101=CL
unmod Down      :102=DOWN
unmod Right     :103=CR
unmod Enter     :104=ENTER
