;;;;; xyscript-dvorak.kbd
;;;;; Dvorak layout, based on xyscript-internal.kbd
;
KEYS=104
CAPS=58,T:C
SHIFT=42,54
ALT=56,98
CTRL=29,99
;
TABLE=
unmod Esc       :1=KF
unmod 1         :2=1
unmod 2         :3=2
unmod 3         :4=3
unmod 4         :5=4
unmod 5         :6=5
unmod 6         :7=6
unmod 7         :8=7
unmod 8         :9=8
unmod 9         :10=9
unmod 0         :11=0
unmod [         :12=[
unmod ]         :13=]
unmod Backspace :14=BD
unmod Tab       :15=TAB
unmod '         :16='
unmod ,         :17=,
unmod .         :18=.
unmod P         :19=p
unmod Y         :20=y
unmod F         :21=f
unmod G         :22=g
unmod C         :23=c
unmod R         :24=r
unmod L         :25=l
unmod /         :26=/
unmod =         :27==
unmod Enter     :28=ENTER
unmod A         :30=a
unmod O         :31=o
unmod E         :32=e
unmod U         :33=u
unmod I         :34=i
unmod D         :35=d
unmod H         :36=h
unmod T         :37=t
