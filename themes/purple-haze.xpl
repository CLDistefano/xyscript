# XyScript color theme -- purple-haze.xpl

# Editor text (foreground) colour — R G B, 0-255
FGCOLOR 178 178 224

# Editor background colour — R G B, 0-255
BGCOLOR 49 33 67

# UI chrome text colour — R G B, 0-255
UIFGCOLOR 130 130 200

# UI chrome background colour — R G B, 0-255
UIBGCOLOR 19 6 31

# $CWD path text colour — R G B, 0-255
PAFGCOLOR $UIBGCOLOR

# $CWD path background colour — R G B, 0-255
PABGCOLOR $UIFGCOLOR

# Caret colour — R G B, 0-255
CRCOLOR 140 140 255

# Command-line caret colour — R G B, 0-255
CMCRCOLOR 125 125 135

# UI separator colour (panel rules + tab dividers) — R G B, 0-255
SEPCOLOR 40 40 40

# Selection background colour — R G B, 0-255
SELBGCOLOR 25 25 55

# Selected-text colour — R G B, 0-255
SELFGCOLOR 120 120 130

# Highlight URLs and Ctrl+click to open them — on | off
URLHIGHLIGHT on

# URL highlight text colour — R G B, 0-255
URLFGCOLOR 150 150 255

# URL highlight background colour — R G B, 0-255
URLBGCOLOR $BGCOLOR

# Bookmark gutter dot colour — R G B, 0-255
MARKFGCOLOR 207 179 129

# Bookmark gutter background colour — R G B, 0-255
MARKBGCOLOR $BGCOLOR

# FIND highlight background colour — R G B, 0-255
FINDBGCOLOR 56 96 21

# FIND-match text colour — R G B, 0-255
FINDFGCOLOR 70 70 90

# Spelling underline colour — R G B, 0-255
SPELLCOLOR 205 205 0

# Grammar underline colour — R G B, 0-255
GRAMMARCOLOR 0 205 205

# Active split-pane border colour — R G B, 0-255
PANECOLOR 45 40 181

# Active-tab title background — R G B, 0-255
TABBGCOLOR active 30 15 82

# Hovered-tab title background — R G B, 0-255
TABBGCOLOR hover 37 8 50

# TXT dialog text colour — R G B, 0-255
TXTFGCOLOR $FGCOLOR

# TXT dialog background colour — R G B, 0-255
TXTBGCOLOR $BGCOLOR

# Line-number gutter text colour -- R G B, 0-255
LNFGCOLOR 19 3 27

# Line-number gutter background colour -- R G B, 0-255
LNBGCOLOR 130 130 180

# EMPH emphasis text colour — R G B, 0-255
EMPHFGCOLOR 180 120 250

# EMPH emphasis background colour — R G B, 0-255
EMPHBGCOLOR 26 70 15

# Syntax-highlighting palette — derived from this theme's colours (token kind -> R G B)
HLCOLOR heading 121 121 216
HLCOLOR emphasis 141 141 176
HLCOLOR strong 204 204 215
HLCOLOR code 124 195 116
HLCOLOR link 118 194 219
HLCOLOR quote 182 132 205
HLCOLOR rule 106 106 160
HLCOLOR keyword 186 121 216
HLCOLOR string 160 209 117
HLCOLOR comment 178 138 100
HLCOLOR number 220 220 116
HLCOLOR function 207 179 129
