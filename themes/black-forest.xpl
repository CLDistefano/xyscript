# XyScript color theme -- black-forest.xpl

# Editor text (foreground) color — R G B, 0-255
FGCOLOR 150 152 150

# Editor background color — R G B, 0-255
BGCOLOR 7 5 7

# UI chrome text color — R G B, 0-255
UIFGCOLOR 130 130 200

# UI chrome background color — R G B, 0-255
UIBGCOLOR 4 20 16

# $CWD path text color — R G B, 0-255
PAFGCOLOR 150 153 150

# $CWD path background color — R G B, 0-255
PABGCOLOR 10 35 20

# Caret color — R G B, 0-255
CRCOLOR 140 140 255

# Command-line caret color — R G B, 0-255
CMCRCOLOR 125 125 135

# UI separator color (panel rules + tab dividers) — R G B, 0-255
SEPCOLOR 40 40 40

# Selection background color — R G B, 0-255
SELBGCOLOR 0 26 15

# Selected-text color — R G B, 0-255
SELFGCOLOR 235 235 220

# Highlight URLs and Ctrl+click to open them — on | off
URLHIGHLIGHT on

# URL highlight text color — R G B, 0-255
URLFGCOLOR 150 150 255

# URL highlight background color — R G B, 0-255
URLBGCOLOR $BGCOLOR

# Bookmark gutter dot color — R G B, 0-255
MARKFGCOLOR 197 169 119

# Bookmark gutter background color — R G B, 0-255
MARKBGCOLOR $BGCOLOR

# FIND highlight background color — R G B, 0-255
FINDBGCOLOR 56 96 21

# FIND-match text color — R G B, 0-255
FINDFGCOLOR 70 70 90

# Spelling underline color — R G B, 0-255
SPELLCOLOR 205 205 0

# Grammar underline color — R G B, 0-255
GRAMMARCOLOR 0 205 205

# Active split-pane border color — R G B, 0-255
PANECOLOR 45 40 181

# Active-tab title background — R G B, 0-255
TABBGCOLOR active 30 15 82

# Hovered-tab title background — R G B, 0-255
TABBGCOLOR hover 37 8 50

# TXT dialog text color — R G B, 0-255
TXTFGCOLOR $FGCOLOR

# TXT dialog background color — R G B, 0-255
TXTBGCOLOR $BGCOLOR

# Line-number gutter text color -- R G B, 0-255
LNFGCOLOR 110 113 110

# Line-number gutter background color -- R G B, 0-255
LNBGCOLOR 7 0 30

# EMPH emphasis text color — R G B, 0-255
EMPHFGCOLOR 235 235 220

# EMPH emphasis background color — R G B, 0-255
EMPHBGCOLOR 30 52 53

# Scratchpad window foreground color -- R G B, 0-255
SCRATCHFGCOLOR 133 133 207

# Scratchpad window background color -- R G B, 0-255
SCRATCHBGCOLOR $UIBGCOLOR

# Syntax-highlighting palette — derived from this theme's colours (token kind -> R G B)
HLCOLOR heading 121 121 216
HLCOLOR emphasis 141 141 176
HLCOLOR strong 204 204 215
HLCOLOR code 124 195 116
HLCOLOR link 118 194 219
HLCOLOR quote 182 132 205
HLCOLOR rule 106 106 160
HLCOLOR keyword 186 121 216
HLCOLOR string 160 209 117
HLCOLOR comment 178 138 100
HLCOLOR number 220 220 116
HLCOLOR function 207 179 129
