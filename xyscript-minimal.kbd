;KB;; xyscript-minimal.kbd
;;;;; The built-in BASELINE keyboard, loaded by `CLEARKBD`. It is NOT empty: a
;;;;; truly empty map leaves the GUI unable to edit (Backspace/arrows/Enter are
;;;;; all KBD-defined commands), so "clear" means "reset to a small, usable,
;;;;; editable default" — enough to type, edit, navigate, and reach the command
;;;;; line + LOADKBD to install a fuller layout. Same runnable-XPL format as any
;;;;; KBD; the same terse self-inserting convention (`16=q`) applies.
;
KEYS=104
SHIFT=42,54
CTRL=29,99
;
; ---- Unshifted: typing + the editing/navigation essentials ----
TABLE=
unmod Esc       :1=KF
unmod Tab       :15=TAB
unmod Backspace :14=BD
unmod Enter     :28=ENTER
unmod 1         :2=1
unmod 2         :3=2
unmod 3         :4=3
unmod 4         :5=4
unmod 5         :6=5
unmod 6         :7=6
unmod 7         :8=7
unmod 8         :9=8
unmod 9         :10=9
unmod 0         :11=0
unmod Q         :16=q
unmod W         :17=w
unmod E         :18=e
unmod R         :19=r
unmod T         :20=t
unmod Y         :21=y
unmod U         :22=u
unmod I         :23=i
unmod O         :24=o
unmod P         :25=p
unmod A         :30=a
unmod S         :31=s
unmod D         :32=d
unmod F         :33=f
unmod G         :34=g
unmod H         :35=h
unmod J         :36=j
unmod K         :37=k
unmod L         :38=l
unmod Z         :44=z
unmod X         :45=x
unmod C         :46=c
unmod V         :47=v
unmod B         :48=b
unmod N         :49=n
unmod M         :50=m
unmod -         :12=-
unmod =         :13="="
unmod [         :26=[
unmod ]         :27=]
unmod ;         :39=;
unmod '         :40='
unmod `         :41=`
unmod \         :43="\\"
unmod ,         :51=,
unmod .         :52=.
unmod /         :53=/
unmod Space     :57=" "
unmod F5        :63=BC
unmod F9        :67=XC
unmod F10       :68=TH
;Comment        ; NumPad editing cluster
unmod Numpad 7  :71=EL
unmod Numpad 8  :72=LU
unmod Numpad 9  :73=PU
unmod Numpad 4  :75=CL
unmod Numpad 6  :77=CR
unmod Numpad 1  :79=ER
unmod Numpad 2  :80=LD
unmod Numpad 3  :81=PD
unmod Numpad .  :83=RC
unmod Enter     :104=ENTER
; gray nav cluster (classic codes 91-103) + forward-delete
90=RC
91=KF
92=HOME
93=PU
95=RC
96=END
97=PD
100=UP
101=LEFT
102=DOWN
103=RIGHT
;
; ---- Shift: uppercase, shifted punctuation, Shift+nav extends the selection ----
TABLE=SHIFT
shift Esc       :1=KF
shift Backspace :14=BD
shift Tab       :15=TAB out
shift Enter     :28=ENTER
shift Q         :16=Q
shift W         :17=W
shift E         :18=E
shift R         :19=R
shift T         :20=T
shift Y         :21=Y
shift U         :22=U
shift I         :23=I
shift O         :24=O
shift P         :25=P
shift A         :30=A
shift S         :31=S
shift D         :32=D
shift F         :33=F
shift G         :34=G
shift H         :35=H
shift J         :36=J
shift K         :37=K
shift L         :38=L
shift Z         :44=Z
shift X         :45=X
shift C         :46=C
shift V         :47=V
shift B         :48=B
shift N         :49=N
shift M         :50=M
shift 1         :2=!
shift 2         :3=@
shift 3         :4=#
shift 4         :5=$
shift 5         :6=%
shift 6         :7=^
shift 7         :8=&
shift 8         :9=*
shift 9         :10=(
shift 0         :11=)
shift -         :12=_
shift =         :13=+
shift [         :26={
shift ]         :27=}
shift ;         :39=:
shift '         :40="\""
shift `         :41=~
shift \         :43=|
shift ,         :51=<
shift .         :52=>
shift /         :53=?
shift Space     :57=" "
shift Numpad 7  :71=EL
shift Numpad 8  :72=UP SEL
shift Numpad 9  :73=PU SEL
shift Numpad 4  :75=LEFT SEL
shift Numpad 6  :77=RIGHT SEL
shift Numpad 1  :79=ER
shift Numpad 2  :80=DOWN SEL
shift Numpad 3  :81=PD SEL
shift Numpad .  :83=RW
shift Home      :92=HOME SEL
shift PgUp      :93=PU SEL
shift Del       :95=RW
shift End       :96=END SEL
shift PgDn      :97=PD SEL
shift Up        :100=UP SEL
shift Left      :101=LEFT SEL
shift Down      :102=DOWN SEL
shift Right     :103=RIGHT SEL
shift Enter     :104=ENTER
;
; ---- Ctrl: open the command line, LOADKBD, save/new/open, clipboard, word/doc motion ----
TABLE=CTRL
ctrl Esc       :1=KF
ctrl Tab       :15=KF
ctrl W         :17=AB/V
ctrl E         :18=cmline
ctrl Y         :21=GT;REDO
ctrl U         :22=MDA UL
ctrl I         :23=MDA IT
ctrl P         :25=PRINT
ctrl [         :26=EDFONT -1
ctrl ]         :27=EDFONT +1
;Comment       ;; Ctrl+Enter on Dir listing opens file in its associated app
ctrl Enter     :28=IF $D1;X/NV start $DR;ELSE;ENTER;EI
ctrl A         :30=DFA
ctrl S         :31=SAVE
ctrl F         :33=FIND
ctrl N         :49=NEW
ctrl O         :24=OPEN
ctrl Z         :44=UNDO
ctrl X         :45=CUT
ctrl C         :46=COPY
ctrl V         :47=PASTE
ctrl B         :48=MDA BO
ctrl Numpad 7  :71=TF
ctrl Numpad 8  :72=LU
ctrl Numpad 9  :73=MD
ctrl Numpad -  :74=EDFONT -1
ctrl Numpad 4  :75=PW
ctrl Numpad 6  :77=NW
ctrl Numpad +  :78=EDFONT +1
ctrl Numpad 1  :79=BF
ctrl Numpad 2  :80=LD
ctrl Numpad 3  :81=MU
ctrl Home      :92=TF
ctrl End       :96=BF
ctrl Up        :100=PP
ctrl Left      :101=PW
ctrl Down      :102=NP
ctrl Right     :103=NW
