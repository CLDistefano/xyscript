;KB;; xyscript-default.kbd
;;;;; The built-in BASELINE keyboard, loaded by `CLEARKBD`. It is NOT empty: a
;;;;; truly empty map leaves the GUI unable to edit (Backspace/arrows/Enter are
;;;;; all KBD-defined commands), so "clear" means "reset to a small, usable,
;;;;; editable default" — enough to type, edit, navigate, and reach the command
;;;;; line + LOADKBD to install a fuller layout. Same runnable-XPL format as any
;;;;; KBD; the same terse self-inserting convention (`16=q`) applies.
;
KEYS=104
SHIFT=42,54
CTRL=29,99
;
; ---- Unshifted: typing + the editing/navigation essentials ----
TABLE=
1=KF
15=TAB
14=BD
28=ENTER
2=1
3=2
4=3
5=4
6=5
7=6
8=7
9=8
10=9
11=0
16=q
17=w
18=e
19=r
20=t
21=y
22=u
23=i
24=o
25=p
30=a
31=s
32=d
33=f
34=g
35=h
36=j
37=k
38=l
44=z
45=x
46=c
47=v
48=b
49=n
50=m
12=-
13="="
26=[
27=]
39=;
40='
41=`
43="\\"
51=,
52=.
53=/
57=" "
63=BC
67=XC
68=TH
; NumPad editing cluster
71=EL
72=LU
73=PU
75=CL
77=CR
79=ER
80=LD
81=PD
83=RC
104=ENTER
; gray nav cluster (classic codes 91-103) + forward-delete
90=RC
91=KF
92=HOME
93=PU
95=RC
96=END
97=PD
100=UP
101=LEFT
102=DOWN
103=RIGHT
