;KB;; xyscript-mykbd.kbd
;;;;; A personal, standalone copy of the built-in baseline layout (the one
;;;;; `CLEARKBD` resets to). Edit this freely and load it with:
;;;;;     LOADKBD xyscript-kbd/kbd/xyscript-mykbd.kbd   (or Ctrl+L → pick it)
;;;;; Editing THIS file never touches the compiled-in CLEARKBD baseline
;;;;; (that lives in xyscript-default.kbd). Same runnable-XPL format as any KBD;
;;;;; the terse self-inserting convention (`16=q`) applies.
;
KEYS=104
SHIFT=42,54
CTRL=29,99
;
; ---- Unshifted: typing + the editing/navigation essentials ----
TABLE=
1=KF
15=TAB
14=BD
28=ENTER
2=1
3=2
4=3
5=4
6=5
7=6
8=7
9=8
10=9
11=0
16=q
17=w
18=e
19=r
20=t
21=y
22=u
23=i
24=o
25=p
30=a
31=s
32=d
33=f
34=g
35=h
36=j
37=k
38=l
44=z
45=x
46=c
47=v
48=b
49=n
50=m
12=-
13="="
26=[
27=]
39=;
40='
41=`
43="\\"
51=,
52=.
53=/
57=" "
; gray nav cluster (classic codes 91-103) + forward-delete
90=RC
91=KF
92=HOME
93=PU
95=RC
96=END
97=PD
100=UP
101=LEFT
102=DOWN
103=RIGHT
;
; ---- Shift: uppercase, shifted punctuation, Shift+nav extends the selection ----
TABLE=SHIFT
1=KF
14=BD
15=KF
28=ENTER
16=Q
17=W
18=E
19=R
20=T
21=Y
22=U
23=I
24=O
25=P
