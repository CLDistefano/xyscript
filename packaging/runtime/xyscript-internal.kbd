TABLE=ALT+CAPS,ALT
; NOTE: Alt+F/E/S/V/D/T/N/H are the menu-bar accelerators (Alt+<underlined letter> opens that menu on
; Windows/Linux). Those letters are set to KF here (pass-through) rather than an @X binder so the menu
; opens; the app claims the chord only when it is KF or unbound. Alt+S is kept as SW (Shell Output).
alt+caps,alt Esc       :1=ES
;Comment               ;2=@1
alt+caps,alt 1         :2=IF $SE;LDPM X;ELSE;PR No text selection.;EI
;Comment               ;3=@2
alt+caps,alt 2         :3=&X
alt+caps,alt 3         :4=@3
alt+caps,alt 4         :5=@4
alt+caps,alt 5         :6=@5
alt+caps,alt 6         :7=@6
alt+caps,alt 7         :8=@7
alt+caps,alt 8         :9=@8
alt+caps,alt 9         :10=@9
