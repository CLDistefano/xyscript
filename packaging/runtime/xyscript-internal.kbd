alt+caps,alt Tab       :15=NOP
alt+caps,alt Q         :16=@Q
alt+caps,alt W         :17=@W
alt+caps,alt E         :18=KF
alt+caps,alt R         :19=@R
alt+caps,alt T         :20=KF
