;Comment        ;; Delete from cursor to next punctuation mark
shift Numpad -  :74=QUIET;GT;XD;DF;SE/R/X /\s?[.?!,;:@`\"()\[\]{}\\\n]/;IF NOT $ERROR;CL;DZ;DN;EI;XD
shift Numpad 4  :75=PW
shift Numpad 6  :77=NW
