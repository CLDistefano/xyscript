;;;;; xyscript-internal.kbd
;;;;; This is the keyboard layout, internal to xyscript.exe, that
;;;;; takes effect if no KBD file is loaded.
;
KEYS=104
CAPS=58,T:C
SHIFT=42,54
ALT=56,98
CTRL=29,99
;
TABLE=
unmod Esc       :1=KF
unmod 1         :2=1
unmod 2         :3=2
unmod 3         :4=3
unmod 4         :5=4
unmod 5         :6=5
unmod 6         :7=6
unmod 7         :8=7
unmod 8         :9=8
unmod 9         :10=9
unmod 0         :11=0
unmod -         :12=-
unmod =         :13==
unmod Backspace :14=BD
unmod Tab       :15=TAB
unmod Q         :16=q
unmod W         :17=w
unmod E         :18=e
unmod R         :19=r
unmod T         :20=t
unmod Y         :21=y
unmod U         :22=u
unmod I         :23=i
unmod O         :24=o
unmod P         :25=p
unmod [         :26=[
unmod ]         :27=]
unmod Enter     :28=ENTER
unmod A         :30=a
unmod S         :31=s
unmod D         :32=d
unmod F         :33=f
unmod G         :34=g
unmod H         :35=h
unmod J         :36=j
unmod K         :37=k
unmod L         :38=l
unmod ;         :39=;
